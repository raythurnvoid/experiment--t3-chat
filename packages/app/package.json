	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "pnpm lint:tsc && pnpm lint:oxlint && pnpm check:plugin-sdk-types",
		"lint:tsc": "tsx scripts/typecheck.ts tsconfig.lint.json",
		"lint:tsc:full": "tsx scripts/typecheck.ts",
		"lint:oxlint": "oxlint --type-aware src server shared convex --ignore-pattern convex/_generated/**",
		"generate:plugin-sdk-types": "tsx scripts/generate-plugin-sdk-types.ts",
		"check:plugin-sdk-types": "tsx scripts/generate-plugin-sdk-types.ts --check",
		"patch:typescript-hover": "tsx src/script/patch-typescript-hover.ts",
		"preview": "vite preview",
		"format": "oxfmt --write .",
		"generate:app-colors": "tsx scripts/generate-color-ts-mod.ts",
		"bench:utf8-byte-size:node": "tsx scripts/bench-utf8-byte-size-node.ts",
		"bench:utf8-byte-size:edge": "vitest bench shared/files-utf8-byte-size.edge.bench.ts --project convex --run",
		"test": "vitest",
		"test:once": "vitest run --testTimeout 30000 --hookTimeout 30000 --teardownTimeout 30000",
		"test:files:full-size": "vitest run --project convex convex/files_pending_update_runs_copy.test.ts convex/files_pending_update_plans.test.ts -t \"(?:saves 1,000 Copy outputs beside one ordinary edit|plans 10,001 unrelated saved Move proposals as 10,001 units)$\" --no-file-parallelism",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:coverage": "vitest run --coverage --coverage.reporter=text"
	},
