# Browser resource hint hosts. Set real values in `.env.local` or the build environment.
# VITE_R2_FILES_DOWNLOAD_HOST=example.r2.cloudflarestorage.com
# VITE_CLERK_FRONTEND_API_HOST=example.clerk.accounts.dev

# Load ONE plugin's UI frame from a local dev server instead of its published bundle, so a UI
# change can be checked in the browser without publishing it. Development builds only: Vite erases
# the branch that reads these from a production build. Both must be set, the origin must be a bare
# origin, and it must be the exact origin the dev server serves — a different port is refused.
#
# Plugin data works there without more switches: the host delivers the plugin-session JWT with the
# session, so the frame's own Convex client authenticates from the init message. Only a frame on an
# SDK older than 0.11.0 exchanges the token itself; for that, set PLUGINS_UI_DEV_EXCHANGE_ORIGIN on
# the Convex deployment to the same bare origin (`convex env set PLUGINS_UI_DEV_EXCHANGE_ORIGIN
# <origin>`). Unset it (or leave it unset in production) and the exchange stays same-origin only.
#
# VITE_PLUGIN_UI_DEV_VERSION_ID=<plugins_versions doc id>
# VITE_PLUGIN_UI_DEV_ORIGIN=http://localhost:5174
