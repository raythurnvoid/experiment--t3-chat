{
	"name": "bonobo-plugin-sdk",
	"private": false,
	"version": "0.13.1",
	"license": "Apache-2.0",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts"
		},
		"./frontend": {
			"types": "./frontend.d.ts",
			"import": "./frontend.js"
		},
		"./convex-api": {
			"types": "./convex-api.d.ts"
		}
	},
	"scripts": {
		"test": "vitest",
		"test:once": "vitest run --testTimeout 30000 --hookTimeout 30000 --teardownTimeout 30000",
		"typecheck": "tsc --allowJs --checkJs --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck frontend.js && tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck frontend.test-d.ts"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20260410.1",
		"convex": "^1.42.2"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"happy-dom": "20.0.11",
		"react": "^19.2.4",
		"typescript": "^7.0.2",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@10.33.0"
}
