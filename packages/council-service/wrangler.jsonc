{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "bonobo-council-service",
	"main": "src/index.ts",
	// From 2026-08-04 the runtime enables `nodejs_compat` and `nodejs_compat_v2` by itself, so this
	// Worker declares no compatibility flags at all. Adding them back would be a no-op today and a
	// contradiction the next reader has to resolve.
	"compatibility_date": "2026-08-14",
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		// The plugin-asset origin the members-only Council page is served from. It is the only origin
		// the browser-facing API answers a CORS preflight for.
		"COUNCIL_PLUGIN_ORIGIN": "https://grand-finch-267.convex.site",
		"CONVEX_HTTP_URL": "https://grand-finch-267.convex.site",
		// MVP ceilings. A meeting closes at the deadline whatever else happens, and the 26th accepted
		// participant is refused.
		"COUNCIL_MEETING_MAX_MINUTES": "60",
		"COUNCIL_MEETING_MAX_PARTICIPANTS": "25",
		// Workspace folder Council writes meeting artifacts under; each meeting gets a subfolder. The
		// seal-processing prefix contract requires canonical lowercase segments.
		"COUNCIL_DESTINATION_PATH_PREFIX": "/meetings",
		// Release automation overrides this to "true" until the coupled host and plugin smoke passes.
		"COUNCIL_MAINTENANCE": "false",
		// Only local development may skip the trusted `CF-Connecting-IP` header. It covers both doors
		// that key a rate bucket on the caller's address: the guest join (`guest_join_ip`) and every
		// page API call (`page_exchange_ip`). Turning it on keys both buckets on the literal
		// `loopback`, so every caller shares one bucket.
		"COUNCIL_ALLOW_MISSING_CLIENT_IP": "false",
		// PEM SPKI public key the provider signs webhook bodies with. Empty refuses every webhook,
		// fail closed, so the intake cannot silently run unverified.
		"REALTIMEKIT_WEBHOOK_PUBLIC_KEY": ""
	},
	"secrets": {
		// `wrangler deploy` fails when one of these is missing, so a first deploy cannot quietly ship a
		// Worker that refuses every request at runtime.
		"required": [
			"COUNCIL_SERVICE_EXCHANGE_SECRET",
			"REALTIMEKIT_API_TOKEN",
			"REALTIMEKIT_ACCOUNT_ID",
			"REALTIMEKIT_APP_ID",
			"COUNCIL_ROOM_COOKIE_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "COUNCIL_DB",
			"database_name": "bonobo-council",
			"database_id": "b32e1b59-11ad-4086-9c92-72480e820e16",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "COUNCIL_EVENTS",
				"queue": "bonobo-council-events"
			}
		],
		"consumers": [
			{
				// One message per batch: the consumer's only slow-event job is one durable
				// Queue-to-Workflow handoff, and the D1 outbox row owns everything else.
				"queue": "bonobo-council-events",
				"max_batch_size": 1,
				"max_retries": 5,
				"dead_letter_queue": "bonobo-council-events-dlq"
			},
			{
				// The DLQ consumer marks the outbox row dead. Cron redrives a processing or
				// deleting meeting whose current generation is dead once Workflow.get says
				// that instance is gone.
				"queue": "bonobo-council-events-dlq",
				"max_batch_size": 1,
				"max_retries": 1
			}
		]
	},
	"workflows": [
		{
			"binding": "COUNCIL_WORKFLOW",
			"name": "bonobo-council-workflow",
			"class_name": "CouncilWorkflow"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		// The scheduled backstop: deadline enforcement, expiries, outbox and projection
		// reconciliation, delete retries, and tombstone cleanup.
		"crons": ["*/15 * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
