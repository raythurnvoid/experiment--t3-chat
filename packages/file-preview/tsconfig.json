{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node", "vite/client"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "*.ts"]
}
