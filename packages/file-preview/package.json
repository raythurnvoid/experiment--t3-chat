{
	"name": "bonobo-file-preview",
	"private": true,
	"version": "0.0.0",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./protocol": "./src/protocol.ts"
	},
	"scripts": {
		"build": "vite build",
		"build:local": "vite build --mode development",
		"preview:local": "vite preview --mode development",
