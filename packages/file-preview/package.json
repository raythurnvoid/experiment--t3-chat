	},
	"devDependencies": {
		"@types/node": "^24.7.2",
		"playwright": "1.62.0",
		"typescript": "~6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@10.33.0"
}
