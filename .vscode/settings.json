{
	"editor.detectIndentation": false,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	"editor.insertSpaces": false,
	"editor.tabSize": 2,
	"editor.unicodeHighlight.allowedCharacters": {
		// characters common in figma designs
		"’": true
	},
	"editor.pasteAs.enabled": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "always",
		"source.fixAll.ts": "never"
	},
	"oxc.typeAware": true,
	"files.eol": "\n",
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.hg/store/**": true
	},
	"files.associations": {
		"*.css": "tailwindcss",
	},
	"terminal.integrated.cwd": "${workspaceFolder}/packages/app",
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.preferences.importModuleSpecifier": "relative",
	"typescript.preferences.importModuleSpecifierEnding": "js",
	"javascript.preferences.importModuleSpecifier": "relative",
	"javascript.preferences.importModuleSpecifierEnding": "js",
	"oxc.configPath": "packages/app/oxlint.config.ts",
	"oxc.disableNestedConfig": true,
	"oxc.fmt.configPath": "packages/app/.oxfmtrc.json",
	"oxc.tsConfigPath": "packages/app/tsconfig.app.json",
	"markdown.copyFiles.destination": {
		"**/*": "docs-assets/${documentRelativeDirName}${fileName}"
	},
	"tailwindCSS.experimental.configFile": "packages/app/src/app.css",
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[scss]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"workbench.colorCustomizations": {
		"activityBar.background": "#2d3748",
		"activityBar.foreground": "#ffffff",
	},
	"vsicons.presets.angular": true
}